# Copiar a .env y completar. Nunca commitear .env.
ANTHROPIC_API_KEY=
# Connection string de Neon (la del pooler, con "-pooler" en el host).
DATABASE_URL=
# Opcional: conexión directa para `prisma migrate`. Si falta, se deriva de
# DATABASE_URL sacando "-pooler" del host (ver web/prisma.config.ts).
DIRECT_URL=
# Opcional: base para tests de integración (branch "dev" de Neon)
TEST_DATABASE_URL=
