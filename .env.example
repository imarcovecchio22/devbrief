# Copiar a .env y completar. Nunca commitear .env.

# Connection string de Neon (la del pooler, con "-pooler" en el host).
DATABASE_URL=
# Opcional: conexión directa para `prisma migrate`. Si falta, se deriva de
# DATABASE_URL sacando "-pooler" del host (ver web/prisma.config.ts).
DIRECT_URL=
# Opcional: base para tests de integración (branch "dev" de Neon)
TEST_DATABASE_URL=

# Backend del LLM: "claude-code" (default, usa la suscripción de Claude vía
# `claude -p`) o "api" (créditos de la API de Anthropic, se paga por token).
LLM_BACKEND=claude-code
# Solo para LLM_BACKEND=api. Ojo: con el backend claude-code esta variable
# se ignora a propósito, para que nunca se facture por la API.
ANTHROPIC_API_KEY=
# En CI (GitHub Actions): token de la suscripción, generado con
# `claude setup-token`. En local no hace falta si ya hiciste login en Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=
